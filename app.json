{
  "expo": {
    "name": "Attendance",
    "slug": "attendance-login-system",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Attendance uses your location to verify on-site check-ins."
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hasan676.attendanceloginsystem",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Attendance uses your location to verify on-site check-ins."
      }
    },
    "android": {
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "package": "com.hasan676.attendanceloginsystem"
    }
  }
}